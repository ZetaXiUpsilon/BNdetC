# Choose a subset of 3, 5, 6 with sum 8.
BNDETC-IMAGE 0.1
ISA 0.1
INPUT 3 3 5 6
PRIVATE 3
EXPORT REG R2
EXPORT MEM 3 3
CODE
    MOVI R2, 0
    GUESS R0
    MOVI R1, 3
    STORE [R1], R0
    JZ R0, skip_first
    MOVI R1, 0
    LOAD R3, [R1]
    ADD R2, R2, R3
skip_first:
    GUESS R0
    MOVI R1, 4
    STORE [R1], R0
    JZ R0, skip_second
    MOVI R1, 1
    LOAD R3, [R1]
    ADD R2, R2, R3
skip_second:
    GUESS R0
    MOVI R1, 5
    STORE [R1], R0
    JZ R0, check
    MOVI R1, 2
    LOAD R3, [R1]
    ADD R2, R2, R3
check:
    MOVI R4, 8
    EQ R5, R2, R4
    ASSERT R5
    STOP
