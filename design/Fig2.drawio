        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% 1. 顶部：分支生成与逻辑分支\n    BG[\&quot;Branch Generation&lt;br/&gt;(GUESS)\&quot;] --&gt; LB[\&quot;Logical Branches\&quot;]\n    \n    %% 资源约束过渡\n    LB --&gt; RC[\&quot;resource constraint\&quot;]\n    \n    %% 2. 资源受限分流：等待池 vs 活跃分支\n    RC --&gt; PB[\&quot;Pending Branches&lt;br/&gt;/ Pool\&quot;]\n    RC --&gt; AB[\&quot;Active Branches\&quot;]\n    \n    %% 调度进入物理执行槽 (schedule 作为连线标签)\n    AB --&gt; PE[\&quot;Physical Execution&lt;br/&gt;Slots 1 ... P\&quot;]\n    PB --&gt;|schedule| PE\n    \n    %% 3. 校验层\n    PE --&gt; V{VERIFY}\n    \n    %% 4. 三大分支走向\n    %% 4.1 左侧：不可行分支 -&gt; 终止\n    V --&gt; IB[\&quot;Infeasible&lt;br/&gt;Branch\&quot;]\n    IB --&gt; TB[\&quot;Terminate&lt;br/&gt;Branch\&quot;]\n    \n    %% 4.2 中间：可行分支 -&gt; 继续执行 -&gt; 下一轮猜解 -&gt; 虚线回退\n    V --&gt; FB[\&quot;Feasible&lt;br/&gt;Branch\&quot;]\n    FB --&gt; CE[\&quot;Continue&lt;br/&gt;Execution\&quot;]\n    CE --&gt; G[\&quot;GUESS\&quot;]\n    G -.-&gt; B2G[\&quot;back to&lt;br/&gt;Branch Generation\&quot;]\n    \n    %% 4.3 右侧：有效最终解 -&gt; 全局成功信号 -&gt; 终止其余所有分支\n    V --&gt; VS[\&quot;Valid Final&lt;br/&gt;Solution\&quot;]\n    VS --&gt; GSS[\&quot;Global Success&lt;br/&gt;Signal\&quot;]\n    GSS --&gt; TRB[\&quot;Terminate All&lt;br/&gt;Remaining Branches\&quot;]\n\n    %% 样式美化与纯文本处理\n    style RC fill:none,stroke:none\n    style B2G fill:none,stroke:none&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FyEI9wEFEUfIX0FPCrzp-1">
