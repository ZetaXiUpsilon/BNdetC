        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% 串行猜测阶段（一路猜到第 n 层）\n    G1[GUESS 1] --&gt; G2[GUESS 2]\n    G2 --&gt; GDots[...]\n    GDots --&gt; Gn[GUESS n]\n\n    %% 叶子节点彻底展开分支\n    Gn --&gt; B1[Branch 1]\n    Gn --&gt; B2[Branch 2]\n    Gn --&gt; BDots[...]\n    Gn --&gt; B2n[\&quot;Branch 2^n\&quot;]\n\n    %% Branch 1 的叶子验证逻辑\n    B1 --&gt; V1{VERIFY}\n    V1 -- F --&gt; K1[kill]\n    V1 -- T --&gt; A1[alive]\n    A1 --&gt; S1([STOP])\n\n    %% Branch 2 的叶子验证逻辑\n    B2 --&gt; V2{VERIFY}\n    V2 -- F --&gt; K2[kill]\n    V2 -- T --&gt; A2[alive]\n    A2 --&gt; S2([STOP])\n\n    %% Branch 2^n 的叶子验证逻辑\n    B2n --&gt; V3{VERIFY}\n    V3 -- F --&gt; K3[kill]\n    V3 -- T --&gt; A3[alive]\n    A3 --&gt; S3([STOP])\n\n    %% 样式微调：隐藏省略号节点的框线\n    style GDots fill:none,stroke:none\n    style BDots fill:none,stroke:none&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="SeM0WH7jRSf_PmCeJL8t-1">
